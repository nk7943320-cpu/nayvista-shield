{
  "name": "sentinelscan",
  "version": "1.0.0",
  "description": "Production-Quality Cybersecurity Vulnerability Assessment Platform",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "test": "npm run test:scanner && npm run test:backend",
    "test:scanner": "py -m unittest discover -s scanner/tests -p \"test_*.py\" -v",
    "test:backend": "npm --prefix backend test",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "keywords": [
    "cybersecurity",
    "vulnerability-scanner",
    "owasp",
    "security-audit"
  ],
  "author": "SentinelScan Security Team",
  "license": "Apache-2.0"
}

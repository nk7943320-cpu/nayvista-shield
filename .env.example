# ==============================================================================
# NayVista Shield - Production Environment Configuration Template
# ==============================================================================

# Application Port and Host
PORT=5000
HOST=0.0.0.0

# Node Environment ('development' or 'production')
NODE_ENV=production

# Service Type ('all' = monolithic API + embedded worker, 'api' = API only, 'worker' = isolated worker only)
SERVICE_TYPE=all

# Python Binary Path (e.g. 'python3' in Linux / Docker, 'py' in Windows)
PYTHON_BIN=python3

# Maximum Concurrent Scans (Concurrency limit for BullMQ and in-process queue)
MAX_CONCURRENT_SCANS=3

# Scanner Watchdog Timeout in milliseconds (default: 120000ms / 2 minutes)
SCAN_TIMEOUT_MS=120000

# Allow Local / Private Targets (STRICTLY for test pipelines; MUST be false in public production)
ALLOW_LOCAL_TARGETS=false

# PostgreSQL Connection String (Leave empty to use built-in high-performance in-memory adapter)
# Example: postgresql://nayvista:secret_password@postgres:5432/nayvista_shield
DATABASE_URL=

# Redis Connection String (Leave empty to use built-in in-process async queue)
# Example: redis://redis:6379
REDIS_URL=

# AI Provider API Keys (Optional - Heuristic Rule Engine acts as instant fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Strict production validation (fails startup if DATABASE_URL or REDIS_URL missing)
STRICT_PRODUCTION=false
